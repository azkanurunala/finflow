# Copy to .env for local dev. In production (Render) set these in the dashboard,
# NOT in a committed file. .env itself is gitignored.

# MongoDB connection string.
#   Local:      mongodb://localhost:27017
#   Atlas:      mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGO_URL=mongodb://localhost:27017
DB_NAME=finflow

# AI / LLM features (chat parsing, voice, receipt scan, AI insights).
# A plain OpenAI key works (EMERGENT_LLM_KEY can be left blank — it falls back to OPENAI_API_KEY).
OPENAI_API_KEY=
EMERGENT_LLM_KEY=
