# Backend environment — paste these into Railway dashboard (Settings → Variables).
# Never commit a populated .env to the repo.

# MongoDB Atlas connection string.
# Example: mongodb+srv://finflow_user:<password>@cluster0.xxxxx.mongodb.net/
MONGO_URL=

# Database name within the cluster.
DB_NAME=finflow

# OpenAI API key. ROTATE the previously-leaked key on platform.openai.com
# before pasting this — the old hardcoded key is now in public git history.
OPENAI_API_KEY=

# Optional model overrides — defaults are reasonable for production.
# LLM_TEXT_MODEL=gpt-4o-mini
# LLM_VISION_MODEL=gpt-4o
