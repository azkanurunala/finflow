# Copy to .env for local dev. In production (Render) set these in the dashboard,
# NOT in a committed file. .env itself is gitignored.

# MongoDB connection string.
#   Local:      mongodb://localhost:27017
#   Atlas:      mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGO_URL=mongodb://localhost:27017
DB_NAME=finflow

# AI / LLM features (chat parsing, voice, receipt scan, AI insights) — runs on the OpenAI API.
OPENAI_API_KEY=
# Chat parsing + receipt OCR (vision). Set a cheaper "mini" model to save tokens
# (e.g. gpt-4o-mini or gpt-5-mini — both support vision). Default gpt-5.2.
OPENAI_MODEL=gpt-5.2
# Voice transcription. Cheaper option: gpt-4o-mini-transcribe. Default whisper-1.
OPENAI_TRANSCRIBE_MODEL=whisper-1

# Sign in with Google / Apple (server-side token verification).
# GOOGLE_CLIENT_IDS: comma-separated OAuth client IDs the app uses (iOS, Android, Web),
# created in Google Cloud Console. Used to validate the ID token audience.
GOOGLE_CLIENT_IDS=
# Apple: the app bundle id is the token audience.
APPLE_BUNDLE_ID=com.azkanura.finflow

# Admin token to generate redeem codes (POST /api/admin/codes, header X-Admin-Token).
ADMIN_TOKEN=

# RevenueCat (paywall / IAP). SECRET_KEY = server-side REST key (read entitlements).
# WEBHOOK_AUTH = the Authorization header value you set on the RevenueCat webhook.
REVENUECAT_SECRET_KEY=
REVENUECAT_WEBHOOK_AUTH=
