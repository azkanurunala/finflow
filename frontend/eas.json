{
  "cli": {
    "version": ">= 16.28.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_BACKEND_URL": "https://bugfix-brigade-3.preview.emergentagent.com",
        "EXPO_PUBLIC_AUTH_URL": "https://auth.emergentagent.com",
        "EXPO_PUBLIC_EXCHANGE_RATE_API_URL": "https://api.exchangerate-api.com/v4/latest/"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_BACKEND_URL": "https://bugfix-brigade-3.preview.emergentagent.com",
        "EXPO_PUBLIC_AUTH_URL": "https://auth.emergentagent.com",
        "EXPO_PUBLIC_EXCHANGE_RATE_API_URL": "https://api.exchangerate-api.com/v4/latest/"
      }
    }
  },
  "submit": {
    "production": {}
  }
}