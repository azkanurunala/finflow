# Frontend public env. EXPO_PUBLIC_* are inlined at build time (and read by
# Expo Go in dev). For DEV: copy this to `.env`. For PRODUCTION/preview builds:
# put the SAME keys under eas.json → build.<profile>.env.
# These are all publishable (client-side) values, not secrets.

# Backend API base URL.
EXPO_PUBLIC_BACKEND_URL=https://finflow-backend-fshd.onrender.com

# Google Sign-In OAuth client IDs (Google Cloud Console → APIs & Services →
# Credentials → OAuth client IDs). Create one each for iOS, Android, Web.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=000000000000-xxxxxxxx.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=000000000000-xxxxxxxx.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=000000000000-xxxxxxxx.apps.googleusercontent.com

# RevenueCat public SDK API keys (RevenueCat dashboard → Project → API keys).
EXPO_PUBLIC_REVENUECAT_IOS_KEY=appl_xxxxxxxxxxxxxxxxxxxx
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=goog_xxxxxxxxxxxxxxxxxxxx
